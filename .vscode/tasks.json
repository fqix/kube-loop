{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "npm: install",
      "type": "npm",
      "script": "install",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
      "label": "build: helper",
      "type": "shell",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "command": "./build/bundle-helper.sh",
      "args": [
        "dev"
      ],
      "windows": {
        "options": {
          "shell": {
            "executable": "bash",
            "args": [
              "-lc"
            ]
          }
        },
        "command": "./build/bundle-helper.sh dev"
      },
      "problemMatcher": [
        "$go"
      ]
    },
    {
      "label": "build: desktop host",
      "type": "shell",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "command": "go",
      "args": [
        "build",
        "-gcflags",
        "all=-N -l",
        "-o",
        "build/bin/kubeloop-desktop-host",
        "./cmd/kubeloop-desktop-host"
      ],
      "windows": {
        "args": [
          "build",
          "-gcflags",
          "all=-N -l",
          "-o",
          "build/bin/kubeloop-desktop-host.exe",
          "./cmd/kubeloop-desktop-host"
        ]
      },
      "dependsOn": [
        "build: helper",
        "sing-box: build debug binary"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$go"
      ]
    },
    {
      "label": "sing-box: build debug binary",
      "type": "process",
      "command": "go",
      "args": [
        "run",
        "./build/singbox-debug.go"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": [
        "$go"
      ],
      "presentation": {
        "clear": true,
        "panel": "dedicated"
      }
    },
    {
      "label": "KubeLoop: run desktop app with sing-box source",
      "type": "shell",
      "command": "npm run dev:desktop",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "KUBELOOP_SINGBOX_SOURCE": "debug"
        }
      },
      "dependsOn": [
        "build: desktop host",
        "build: helper",
        "sing-box: build debug binary"
      ],
      "problemMatcher": [],
      "presentation": {
        "clear": true,
        "panel": "dedicated",
        "reveal": "always"
      }
    }
  ]
}
