{
  "name": "kubeloop-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": ".vite/build/main.cjs",
  "scripts": {
    "build": "tsc",
    "build:host": "go build -o ../build/bin/kubeloop-desktop-host ../cmd/kubeloop-desktop-host",
    "start": "electron-forge start",
    "start:debug": "electron-forge start -- --remote-debugging-port=9222",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "test": "node --experimental-strip-types --test src/renderer/components/layout/*.test.mjs src/renderer/components/sessions/*.test.mjs src/renderer/components/workspace/*.test.mjs",
    "test:shell": "node src/main/bridge-smoke.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.27.0",
    "radix-ui": "^1.6.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.8.0",
    "shadcn": "^4.16.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron-forge/shared-types": "^7.11.2",
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^44.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.4"
  }
}
