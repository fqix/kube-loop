{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Electron: Attach to kubeloop-backend",
      "type": "go",
      "request": "attach",
      "mode": "local",
      "processId": "kubeloop-backend",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Go: Test package",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${fileDirname}",
      "args": ["-count=1"]
    },
    {
      "name": "Go: Test file",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${file}",
      "args": ["-count=1"]
    },
    {
      "name": "third_party: Debug Sing-box",
      "type": "go",
      "request": "attach",
      "mode": "local",
      "debugAdapter": "dlv-dap",
      "processId": "sing-box",
      "asRoot": true,
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}/third_party/sing-box",
      "stopOnEntry": false,
      "showLog": true
    }
  ]
}
