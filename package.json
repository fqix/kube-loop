{
  "name": "kubeloop-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Local development network for Kubernetes",
  "author": "KubeLoop",
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/electron-dev.mjs",
    "dev:shell": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node --experimental-strip-types --test src/renderer/src/components/layout/*.test.mjs src/renderer/src/components/sessions/*.test.mjs src/renderer/src/components/workspace/*.test.mjs",
    "package": "electron-builder --config electron-builder.yml"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.27.0",
    "radix-ui": "^1.6.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "shadcn": "^4.16.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
